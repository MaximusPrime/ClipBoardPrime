<section id="features" class="py-20 bg-slate-950/60 border-y border-white/10">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="text-center">
      <p class="text-xs font-bold uppercase tracking-widest text-sky-400">Capabilities</p>
      <h2 class="mt-2 font-bold text-3xl text-white sm:text-4xl">Why ClipBoardPrime?</h2>
    </div>

    <div class="mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      <div class="glass rounded-2xl p-6 transition hover:border-sky-500/40">
        <div class="h-12 w-12 rounded-xl bg-sky-500/10 flex items-center justify-center text-sky-400 text-2xl mb-4">
          📋
        </div>
        <h3 class="font-bold text-lg text-white">Rich Clipboard History</h3>
        <p class="mt-2 text-sm text-slate-400 leading-relaxed">Monitors text, HTML, URLs, emails, code snippets, and images. Features Space-bar quick preview and instant live fuzzy search.</p>
      </div>

      <div class="glass rounded-2xl p-6 transition hover:border-sky-500/40">
        <div class="h-12 w-12 rounded-xl bg-sky-500/10 flex items-center justify-center text-sky-400 text-2xl mb-4">
          ⚡
        </div>
        <h3 class="font-bold text-lg text-white">Win32 Direct Auto-Paste</h3>
        <p class="mt-2 text-sm text-slate-400 leading-relaxed">Tracks the previously active window, releases stuck modifier keys, and pastes selected content via SendInput API without switching windows.</p>
      </div>

      <div class="glass rounded-2xl p-6 transition hover:border-sky-500/40">
        <div class="h-12 w-12 rounded-xl bg-sky-500/10 flex items-center justify-center text-sky-400 text-2xl mb-4">
          🏷️
        </div>
        <h3 class="font-bold text-lg text-white">Notes & Color Categories</h3>
        <p class="mt-2 text-sm text-slate-400 leading-relaxed">Convert clipboard items into permanent notes, organize with color-coded categories, pin, and favorite important entries.</p>
      </div>

      <div class="glass rounded-2xl p-6 transition hover:border-sky-500/40">
        <div class="h-12 w-12 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-400 text-2xl mb-4">
          🛡️
        </div>
        <h3 class="font-bold text-lg text-white">Hardware-Backed Security</h3>
        <p class="mt-2 text-sm text-slate-400 leading-relaxed">Encrypt data with Windows safeStorage (DPAPI) & AES-256-GCM. Automatically mask credit cards, API tokens, and sensitive strings.</p>
      </div>
    </div>
  </div>
</section>
