---
const shots = [
  { src: '/ClipBoardPrime/images/screenshots/history-compact.png', title: 'Compact Clipboard History', desc: 'Instant search, filters, space-bar preview, and active window paste' },
  { src: '/ClipBoardPrime/images/screenshots/notes-workspace.png', title: 'Organized Notes Workspace', desc: 'Color-coded categories, pin & favorite notes, rich content editing' },
  { src: '/ClipBoardPrime/images/screenshots/welcome-guided.png', title: 'Guided First-Run Onboarding', desc: 'Quick introduction to shortcuts, features, and local privacy' },
  { src: '/ClipBoardPrime/images/screenshots/live-preferences.png', title: 'Live Theme & Language Personalization', desc: 'Dark, Light, System themes + TR, EN, ZH interface languages' },
  { src: '/ClipBoardPrime/images/screenshots/settings-general.png', title: 'Application & Storage Settings', desc: 'Custom global hotkey, database polling interval, and local history limits' },
];
---

<section id="gallery" class="py-20 bg-slate-950/60 border-y border-white/10 relative">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="text-center">
      <p class="text-xs font-bold uppercase tracking-widest text-sky-400">Interface</p>
      <h2 class="mt-2 font-bold text-3xl text-white sm:text-4xl">Application Screenshots</h2>
      <p class="mt-2 text-sm text-slate-400">Click any image to view in full-screen detail</p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {shots.map((shot, index) => (
        <button
          type="button"
          class="glass group relative overflow-hidden rounded-2xl p-2.5 text-left transition duration-300 hover:border-sky-500/60 hover:shadow-[0_0_30px_rgba(14,165,233,0.2)] focus:outline-none flex flex-col justify-between"
          onclick={`openLightbox('${shot.src}', '${shot.title.replace(/'/g, "\\'")}', '${shot.desc.replace(/'/g, "\\'")}')`}
        >
          <div class="overflow-hidden rounded-xl bg-slate-950/80 min-h-[260px] h-64 w-full flex items-center justify-center p-2 relative border border-white/5">
            <img src={shot.src} alt={shot.title} class="max-h-full max-w-full object-contain transition duration-500 group-hover:scale-[1.03]" loading="lazy" />
            <div class="absolute inset-0 bg-slate-950/40 opacity-0 group-hover:opacity-100 transition duration-300 flex items-center justify-center backdrop-blur-[2px]">
              <span class="rounded-full bg-sky-500/90 text-slate-950 p-3 shadow-lg transform translate-y-2 group-hover:translate-y-0 transition duration-300">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"/></svg>
              </span>
            </div>
          </div>
          <div class="p-3">
            <h3 class="font-bold text-sm text-white group-hover:text-sky-300 transition">{shot.title}</h3>
            <p class="text-xs text-slate-400 mt-1 line-clamp-1">{shot.desc}</p>
          </div>
        </button>
      ))}
    </div>
  </div>

  <!-- Lightbox Modal -->
  <div id="lightbox" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-950/90 backdrop-blur-md transition duration-300">
    <div class="relative max-w-5xl w-full max-h-[90vh] flex flex-col items-center">
      <button
        type="button"
        onclick="closeLightbox()"
        class="absolute -top-12 right-0 text-slate-400 hover:text-white transition p-2 text-sm font-semibold flex items-center gap-1 bg-white/10 rounded-lg px-3"
      >
        ✕ Close (Esc)
      </button>
      <div class="w-full overflow-hidden rounded-2xl border border-white/20 bg-slate-900 shadow-2xl p-3">
        <div class="w-full flex items-center justify-center bg-slate-950 rounded-xl p-2">
          <img id="lightbox-img" src="" alt="" class="max-h-[72vh] max-w-full object-contain rounded-lg shadow-lg" />
        </div>
        <div class="p-4 text-center">
          <h3 id="lightbox-title" class="font-bold text-lg text-white"></h3>
          <p id="lightbox-desc" class="text-xs text-slate-400 mt-1 max-w-2xl mx-auto"></p>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  function openLightbox(src, title, desc) {
    const el = document.getElementById('lightbox');
    const img = document.getElementById('lightbox-img');
    const titleEl = document.getElementById('lightbox-title');
    const descEl = document.getElementById('lightbox-desc');

    if (el && img && titleEl && descEl) {
      img.src = src;
      titleEl.textContent = title;
      descEl.textContent = desc;
      el.classList.remove('hidden');
      el.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeLightbox() {
    const el = document.getElementById('lightbox');
    if (el) {
      el.classList.remove('flex');
      el.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeLightbox();
    }
  });

  document.getElementById('lightbox')?.addEventListener('click', function(e) {
    if (e.target === this) {
      closeLightbox();
    }
  });
</script>
