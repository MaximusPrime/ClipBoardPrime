---
---

<section id="installation" class="py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="text-center">
      <p class="text-xs font-bold uppercase tracking-widest text-sky-400">Distribution</p>
      <h2 class="mt-2 font-bold text-3xl text-white sm:text-4xl">Installation & Requirements</h2>
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-2">
      <div class="glass rounded-2xl p-6">
        <h3 class="font-bold text-xl text-white mb-2">📥 Standard Installer</h3>
        <p class="text-sm text-slate-400 mb-6">Installs into standard Windows directories with optional launch at startup.</p>
        <a
          href="https://github.com/MaximusPrime/ClipBoardPrime/releases"
          target="_blank"
          class="inline-block rounded-lg bg-sky-500 hover:bg-sky-400 px-4 py-2 text-xs font-bold text-slate-950 transition hover:brightness-110"
        >
          ClipBoardPrime Setup v1.0.2.exe
        </a>
      </div>

      <div class="glass rounded-2xl p-6">
        <h3 class="font-bold text-xl text-white mb-2">📦 Portable Executable</h3>
        <p class="text-sm text-slate-400 mb-6">Keeps application data inside adjacent data folder; requires no installation.</p>
        <a
          href="https://github.com/MaximusPrime/ClipBoardPrime/releases"
          target="_blank"
          class="inline-block rounded-lg border border-white/20 bg-white/5 px-4 py-2 text-xs font-bold text-white transition hover:bg-white/10 hover:border-sky-500/40"
        >
          ClipBoardPrime Portable v1.0.2.exe
        </a>
      </div>
    </div>

    <div class="mt-10 glass rounded-2xl p-6 text-center">
      <h4 class="font-bold text-sm text-slate-300 uppercase tracking-wider">System Requirements</h4>
      <div class="mt-3 flex flex-wrap justify-center gap-6 text-xs font-medium text-slate-400">
        <span>✓ Windows 10 / Windows 11 (64-bit)</span>
        <span>✓ No administrator rights required</span>
        <span>✓ 100 MB available disk space</span>
      </div>
    </div>
  </div>
</section>
