<section id="security" class="py-20 bg-slate-950/60 border-y border-white/10">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="text-center">
      <p class="text-xs font-bold uppercase tracking-widest text-emerald-400">Privacy First</p>
      <h2 class="mt-2 font-bold text-3xl text-white sm:text-4xl">Security & Isolation Architecture</h2>
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-3">
      <div class="glass rounded-2xl p-6 border-emerald-500/20">
        <h3 class="font-bold text-lg text-emerald-300 mb-2">100% Local Storage</h3>
        <p class="text-sm text-slate-400 leading-relaxed">No cloud endpoints, remote databases, or telemetry. Your data stays entirely on your machine.</p>
      </div>
      <div class="glass rounded-2xl p-6 border-emerald-500/20">
        <h3 class="font-bold text-lg text-emerald-300 mb-2">AES-256-GCM & DPAPI</h3>
        <p class="text-sm text-slate-400 leading-relaxed">Master encryption keys are wrapped using OS account-backed Windows DPAPI via Electron safeStorage API.</p>
      </div>
      <div class="glass rounded-2xl p-6 border-emerald-500/20">
        <h3 class="font-bold text-lg text-emerald-300 mb-2">Encrypted .cpbackup</h3>
        <p class="text-sm text-slate-400 leading-relaxed">Portable backups are exported with AES-256-GCM and scrypt key derivation, protected with user passwords.</p>
      </div>
    </div>
  </div>
</section>
