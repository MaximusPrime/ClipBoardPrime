---
---

<section class="relative overflow-hidden pt-12 pb-20 sm:pt-16 sm:pb-24">
  <div class="absolute top-1/4 left-1/2 -z-10 h-96 w-96 -translate-x-1/2 rounded-full bg-sky-500/15 blur-3xl" aria-hidden="true"></div>

  <div class="mx-auto max-w-5xl px-4 text-center sm:px-6">
    <div class="inline-flex items-center gap-2 rounded-full border border-sky-500/30 bg-sky-500/10 px-4 py-1.5 text-xs font-semibold text-sky-300 shadow-[0_0_15px_rgba(14,165,233,0.15)]">
      <span class="h-2 w-2 rounded-full bg-sky-400 animate-pulse"></span>
      v1.0.3 • Windows 10/11 64-bit
    </div>

    <h1 class="mt-6 font-extrabold text-4xl tracking-tight text-white sm:text-6xl uppercase">
      ClipBoard<span class="blue-text">Prime</span>
    </h1>

    <p class="mt-4 text-lg font-medium text-slate-300 sm:text-2xl max-w-3xl mx-auto">
      Fast, Private, Keyboard-Driven Clipboard Manager for Windows
    </p>

    <p class="mt-4 max-w-2xl mx-auto text-base text-slate-400 leading-relaxed">
      Store clipboard history locally in SQLite, paste into active windows instantly via Win32 SendInput, and convert items into an organized notes workspace.
    </p>

    <!-- CTAs -->
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a
        href="https://github.com/MaximusPrime/ClipBoardPrime/releases/download/v1.0.3/ClipBoardPrime.Setup.Recommended.1.0.3.exe"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 rounded-xl bg-gradient-to-r from-sky-400 via-blue-500 to-indigo-600 px-6 py-3.5 text-sm font-bold text-white shadow-[0_0_30px_rgba(14,165,233,0.35)] transition hover:brightness-110 hover:scale-[1.02] active:scale-[0.98]"
      >
        <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
        Windows Setup
      </a>
      <a
        href="https://github.com/MaximusPrime/ClipBoardPrime/releases"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 rounded-xl border border-white/20 bg-white/5 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-white/10 hover:border-sky-500/30 hover:scale-[1.02] active:scale-[0.98]"
      >
        📦 Portable Edition
      </a>
    </div>

    <p class="mt-3 text-xs text-slate-500 font-medium">A Maximus Prime Software Product</p>

    <!-- Refined Compact Window Mockup -->
    <div class="mt-10 relative mx-auto max-w-xl rounded-2xl border border-white/15 bg-slate-900/90 p-2 shadow-[0_25px_60px_-15px_rgba(14,165,233,0.25)] backdrop-blur-2xl transition duration-500 hover:border-sky-500/40">
      <div class="flex items-center justify-between px-3 py-2 border-b border-white/10">
        <div class="flex items-center gap-2">
          <span class="h-3 w-3 rounded-full bg-red-500/80"></span>
          <span class="h-3 w-3 rounded-full bg-yellow-500/80"></span>
          <span class="h-3 w-3 rounded-full bg-green-500/80"></span>
        </div>
        <span class="text-[11px] font-mono font-medium text-slate-400 tracking-wider">ClipBoardPrime • Compact View</span>
        <div class="w-12"></div>
      </div>
      <div class="overflow-hidden rounded-b-xl bg-slate-950 flex items-center justify-center p-1">
        <img
          src="/ClipBoardPrime/images/screenshots/history-compact.png"
          alt="ClipBoardPrime Compact History"
          class="max-h-[480px] w-auto object-contain rounded-b-lg shadow-inner"
        />
      </div>
    </div>
  </div>
</section>
