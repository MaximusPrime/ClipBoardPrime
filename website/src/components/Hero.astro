---
---

<section class="relative overflow-hidden pt-12 pb-20 sm:pt-20 sm:pb-28">
  <div class="absolute top-1/4 left-1/2 -z-10 h-96 w-96 -translate-x-1/2 rounded-full bg-sky-500/15 blur-3xl" aria-hidden="true"></div>

  <div class="mx-auto max-w-5xl px-4 text-center sm:px-6">
    <div class="inline-flex items-center gap-2 rounded-full border border-sky-500/30 bg-sky-500/10 px-4 py-1.5 text-xs font-semibold text-sky-300">
      <span class="h-2 w-2 rounded-full bg-sky-400 animate-pulse"></span>
      v1.0.1 • Windows 10/11 64-bit
    </div>

    <h1 class="mt-6 font-extrabold text-4xl tracking-tight text-white sm:text-6xl uppercase">
      ClipBoard<span class="blue-text">Prime</span>
    </h1>

    <p class="mt-4 text-lg font-medium text-slate-300 sm:text-2xl max-w-3xl mx-auto">
      Fast, Private, Keyboard-Driven Clipboard Manager for Windows
    </p>

    <p class="mt-4 max-w-2xl mx-auto text-base text-slate-400 leading-relaxed">
      Store clipboard history locally in SQLite, paste into active windows instantly via Win32 SendInput, and convert items into organized notes workspace.
    </p>

    <!-- CTAs -->
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a
        href="https://github.com/MaximusPrime/ClipBoardPrime/releases"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 rounded-xl bg-gradient-to-r from-sky-400 via-blue-500 to-indigo-600 px-6 py-3.5 text-sm font-bold text-white shadow-[0_0_30px_rgba(14,165,233,0.35)] transition hover:brightness-110"
      >
        <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
        Windows Setup (.exe)
      </a>
      <a
        href="https://github.com/MaximusPrime/ClipBoardPrime/releases"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 rounded-xl border border-white/20 bg-white/5 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-white/10 hover:border-sky-500/30"
      >
        📦 Portable Edition (.exe)
      </a>
    </div>

    <p class="mt-4 text-xs text-slate-500">A Maximus Prime Software Product</p>

    <!-- Mockup Preview -->
    <div class="mt-14 relative mx-auto max-w-4xl rounded-2xl border border-white/10 bg-slate-900/80 p-2 shadow-2xl backdrop-blur-xl">
      <div class="flex items-center gap-2 px-3 py-2 border-b border-white/10">
        <span class="h-3 w-3 rounded-full bg-red-500/80"></span>
        <span class="h-3 w-3 rounded-full bg-yellow-500/80"></span>
        <span class="h-3 w-3 rounded-full bg-green-500/80"></span>
        <span class="ml-2 text-xs font-mono text-slate-400">ClipBoardPrime v1.0.1</span>
      </div>
      <img
        src="/ClipBoardPrime/images/screenshots/history-compact.png"
        alt="ClipBoardPrime Compact History"
        class="rounded-b-xl w-full object-cover shadow-inner"
      />
    </div>
  </div>
</section>
