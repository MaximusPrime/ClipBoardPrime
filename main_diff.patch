-/**
- * G├Ârsel hash'ini hesaplar (de─şi┼şiklik alg─▒lama i├ğin).
- */
-function hashImage(image) {
-  try {
-    const buffer = image.toBitmap();
-    return crypto.createHash('md5').update(buffer).digest('hex');
-  } catch (err) {
-    return '';
-  }
-}
