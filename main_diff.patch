-function startClipboardWatcher() {
-  // Mevcut clipboard i├ğeri─şini oku (kar┼ş─▒la┼şt─▒rma i├ğin)
-  try {
-    lastClipboardText = clipboard.readText() || '';
-    lastClipboardHtml = clipboard.readHTML() || '';
-    const img = clipboard.readImage();
-    if (img && !img.isEmpty()) {
-      lastClipboardImageHash = hashImage(img);
-    }
-  } catch (err) {
-    console.error('─░lk clipboard okuma hatas─▒:', err);
-  }
-
-  // Polling interval ayar─▒n─▒ oku
-  let interval = 500;
-  try {
-    if (db.isReady()) {
-      const savedInterval = db.getSetting('pollingInterval');
-      if (savedInterval) {
-        interval = Math.max(200, Math.min(5000, parseInt(savedInterval) || 500));
-      }
-    }
-  } catch (err) {
-    // Varsay─▒lan kullan
-  }
-
-  clipboardWatcher = setInterval(() => {
-    try {
-      checkClipboard();
-    } catch (err) {
-      console.error('Clipboard kontrol hatas─▒:', err);
-    }
-  }, interval);
-}
-
-/**
