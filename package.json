{
  "name": "clipboard-pro-app",
  "version": "1.0.1",
  "description": "Profesyonel Clipboard Manager + Not Paneli",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "rebuild": "electron-rebuild",
    "build": "electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "author": "ClipBoardPro",
  "license": "MIT",
  "build": {
    "appId": "com.clipboardpro.app",
    "productName": "ClipBoardPro",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "files": [
      "src/**/*",
      "database/**/*",
      "main.js",
      "preload.js",
      "package.json",
      "!dist/**/*",
      "!build/**/*",
      "!.git/**/*",
      "!.github/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ]
  }
}
