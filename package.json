{
  "name": "clipboard-prime-app",
  "version": "1.0.3",
  "description": "Profesyonel Clipboard Manager + Not Paneli",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "rebuild": "electron-builder install-app-deps",
    "build": "electron-builder",
    "test": "node scripts/test.js",
    "test:e2e": "node scripts/e2e.js",
    "check": "node scripts/check.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "koffi": "^3.1.2"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "author": {
    "name": "Maximus Prime",
    "email": "maximusprimesoftware@gmail.com",
    "url": "https://github.com/MaximusPrime"
  },
  "contributors": [
    {
      "name": "Maximus Prime Software",
      "email": "maximusprimesoftware@gmail.com",
      "url": "https://maximusprimesoftware.pages.dev/"
    }
  ],
  "homepage": "https://maximusprimesoftware.pages.dev/projects/clipboardprime/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaximusPrime/ClipBoardPrime.git"
  },
  "bugs": {
    "url": "https://github.com/MaximusPrime/ClipBoardPrime/issues",
    "email": "maximusprimesoftware@gmail.com"
  },
  "license": "GPL-3.0-only",
  "build": {
    "appId": "com.clipboardprime.app",
    "productName": "ClipBoardPrime",
    "copyright": "Copyright © 2026 Maximus Prime Software",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "${productName}.Portable.${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}.Setup.Recommended.${version}.${ext}"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "database/**/*",
      "lib/**/*",
      "main.js",
      "preload.js",
      "package.json",
      "!node_modules/better-sqlite3/build/Release/obj/**/*",
      "!node_modules/better-sqlite3/build/Release/test_extension*",
      "!node_modules/better-sqlite3/build/Release/*.{lib,exp,iobj,ipdb}",
      "!node_modules/better-sqlite3/build/deps/**/*",
      "!node_modules/better-sqlite3/build/src/**/*",
      "!node_modules/better-sqlite3/build/*.vcxproj*",
      "!node_modules/better-sqlite3/deps/**/*",
      "!node_modules/better-sqlite3/src/**/*",
      "!dist/**/*",
      "!build/**/*",
      "!.git/**/*",
      "!.github/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/build/Release/better_sqlite3.node"
    ]
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  }
}
